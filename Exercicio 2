import java.util.Scanner; 
    public class Exercicio2{
        public static void main(String [] args){
            Scanner sc = new Scanner(System.in);
            int n, vezes, negativos =0, positivos=0, zeros=0;
            System.out.println("Digite quantas vezes quer executar o programa: ");
            vezes=sc.nextInt();
            for( int i =1; i <= vezes; i++){
                System.out.println("Digite um número: ");
                n=sc.nextInt();
                if(n < 0){
                negativos ++;
                }
                else if(n > 0){
                positivos ++;
                 }
                else if(n == 0){
                zeros ++;
                }
            }
            System.out.println("Foi digitado: "+negativos + " 3negativos.\n");
            System.out.println("Foi digitado: "+positivos + " positivos.\n");
            System.out.println("Foi digitado: "+zeros + " zeros.\n");
            
        }
    }
