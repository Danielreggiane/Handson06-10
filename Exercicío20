import java.util.Scanner;

public class CalculoSerie {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        System.out.print("Digite a quantidade de termos N: ");
        int N = scanner.nextInt();
        
        System.out.print("Digite o valor positivo X: ");
        double X = scanner.nextDouble();
        
        double S = 0.0;
        int denominador = 1;
        int direcao = 1;
        int sinal = -1;
        
        for (int i = 1; i <= N; i++) {
            double numerador = Math.pow(X, i + 1);
            
            long fatorial = 1;
            for (int j = 1; j <= denominador; j++) {
                fatorial *= j;
            }
            
            double termo = (numerador / fatorial) * sinal;
            S += termo;
            
            sinal = -sinal;
            
            if (denominador == 4) {
                direcao = -1;
            } else if (denominador == 1) {
                direcao = 1;
            }
            denominador += direcao;
        }
        
        System.out.println("O valor de S é: " + S);
        
        scanner.close();
    }
}
