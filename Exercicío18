import java.util.Scanner;

public class ConceitoAlunos {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        for (int i = 1; i <= 75; i++) {
            System.out.println("Aluno " + i + " de 75:");
            System.out.print("Número de matrícula: ");
            int matricula = scanner.nextInt();

            System.out.print("Nota numérica final: ");
            double nota = scanner.nextDouble();

            char conceito;
            if (nota > 9.0) {
                conceito = 'A';
            } else if (nota >= 7.0) {
                conceito = 'B';
            } else if (nota >= 5.0) {
                conceito = 'C';
            } else {
                conceito = 'D';
            }

            System.out.println("Matrícula: " + matricula + " | Nota final: " + nota + " | Conceito: " + conceito);
            System.out.println();
        }

        scanner.close();
    }
}

