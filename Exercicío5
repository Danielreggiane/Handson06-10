public class FatorialWhile {
    public static void main(String[] args) {
        int n = 1;
        while (n <= 10) {
            int fatorial = 1;
            int i = 1;
            while (i <= n) {
                fatorial = fatorial * i;
                i++; // O mesmo que i = i + 1
            }
            System.out.println(n + "! = " + fatorial);
            n++;
        }
    }
}
