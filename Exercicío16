public class NumerosPerfeitos {
    public static void main(String[] args) {
        int encontrados = 0;
        long numero = 1;

        while (encontrados < 5) {
            long soma = 0;
            
            for (long i = 1; i <= numero / 2; i++) {
                if (numero % i == 0) {
                    soma += i;
                }
            }
            
            if (soma == numero) {
                System.out.println(numero);
                encontrados++;
            }
            
            numero++;
        }
    }
}
